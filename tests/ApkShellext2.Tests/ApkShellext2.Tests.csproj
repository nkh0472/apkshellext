<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for the shell extension.
       Runs on the .NET Framework 4.8 test host, so the tests exercise exactly the
       assembly that ships: `dotnet test tests\ApkShellext2.Tests\ApkShellext2.Tests.csproj`.

       Why ProjectReference instead of a HintPath <Reference>: a plain reference would
       silently test a stale bin\Release\ApkShellext2.dll. The project reference builds
       the product first and copies its output next to the test assembly; the
       Skip7zPackage property (read by the product's PackageWith7z target) suppresses
       the postbuild 7-Zip packaging, so running the tests never rewrites the publish
       artifact and never needs 7-Zip on PATH.

       Why the tests use reflection for the internal guards instead of
       InternalsVisibleTo: the product is strong-named with a key that is gitignored
       (each checkout generates its own, and CI builds unsigned unless the secret is
       configured), so a friend-assembly declaration can carry no portable public key
       and would fail to compile with CS1726. See TestSupport/ProductApi.cs. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <RootNamespace>ApkShellext2.Tests</RootNamespace>
    <AssemblyName>ApkShellext2.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- test binaries stay under tests\...\bin\<Configuration>\net48 and never land in
         the product publish tree that eng\check-layout.ps1 validates -->
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <!-- the CI product build is the only place that runs with -warnaserror; do not turn
         this project's analyzer/obsolete warnings into build failures -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- ZipArchive: the tests build the archives they parse. The SDK-style net48
         implicit references do not include System.IO.Compression. -->
    <Reference Include="System.IO.Compression" />
    <!-- PreferencesPatternVariableTests drives the real Settings window on an STA
         thread; SDK-style net48 does not reference WinForms implicitly. -->
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Skip7zPackage: only the product's postbuild packaging target reads it -->
    <ProjectReference Include="..\..\ApkShellext2\ApkShellext2.csproj">
      <AdditionalProperties>Skip7zPackage=true</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

</Project>
